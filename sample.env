# Copy to .env beside this file and fill in your own settings.
# Both notebooks read this folder's .env. Never commit the filled-in file.

# Azure ML workspace (notebook 01 only)
SUBSCRIPTION_ID = ""
RESOURCE_GROUP = ""
AML_WORKSPACE_NAME = ""
TENANT_ID = ""

# Compute target. Tiles are read and sent over HTTP, so a CPU cluster is enough - the model
# runs in Foundry, not here.
AML_CPU_CLUSTER = ""

# Managed identity the cluster runs as. Configure permission to call your Foundry deployment
# separately from the local user's permissions.
# Leave empty to use the cluster's system-assigned identity.
AML_MANAGED_IDENTITY_CLIENT_ID = ""

# Foundry (Microsoft Foundry) project that hosts the MedImageInsight-Premium deployment.
# AZURE_AI_PROJECT_ENDPOINT may be the full project URL; the notebooks reduce it to the
# resource endpoint that the /providers/microsoft/v2/embed route lives on.
AZURE_AI_PROJECT_ENDPOINT = ""
AZURE_AI_MODEL_DEPLOYMENT_NAME = "MedImageInsight-Premium"

# Supply your own authorized data; no clinical data is distributed with the example.
# HNE_DATA_NAME is an existing uri_folder data asset containing the slides.
# LABELS_CSV is a private label sheet relative to this folder (or an absolute path).
# Notebook 01 writes the derived cohort to outputs/cohort.csv.
HNE_DATA_NAME = ""
HNE_DATA_VERSION = ""
LABELS_CSV = "data/labels.csv"

# Only for scripts/check_dataset.py, which lists the blob container directly.
HNE_BLOB_CONTAINER_URL = ""
HNE_BLOB_PREFIX = ""
